# Copy to .env.local for a frontend build; never commit real .env files.
# Put server settings in /home/YOU/scoreboard-private/.env OUTSIDE every public directory.
# Point PHP at it using SCOREBOARD_ENV_FILE; see docs/DEPLOYMENT.md.
# Docker Compose reads a root .env file instead. No real credentials are supplied.

# Frontend build settings (public, NOT secrets); no trailing path.
NEXT_PUBLIC_SITE_URL=https://scoreboard.example.org
# Set true only on the real public production site, false for staging.
NEXT_PUBLIC_INDEXABLE=false

# Backend must match the public origin. HTTPS is required for production.
APP_ORIGIN=https://scoreboard.example.org
APP_ALLOW_HTTP=false
DB_HOST=localhost
DB_PORT=3306
DB_NAME=scoreboard
DB_USER=scoreboard
DB_PASSWORD=
# Docker database bootstrap only. Choose a different strong random password.
DB_ROOT_PASSWORD=
# Generate: php backend/manage.php secret
APP_KEY=
# Generate interactively: php backend/manage.php password
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# First-party collection disabled until explicitly configured.
ANALYTICS_ENABLED=false
# Optional public Cloudflare beacon token. Leave blank to disable Cloudflare.
CLOUDFLARE_ANALYTICS_TOKEN=
# Set true ONLY after confirming automatic injection is disabled for this host.
CLOUDFLARE_MANUAL_CONFIRMED=false
# Trusted proxy CIDRs, comma-separated. Empty is safe for direct hosting.
# Add only current official Cloudflare ranges if connections come through it.
TRUSTED_PROXY_CIDRS=
# Per-IP login limits use a short-lived keyed hash. No raw IP stored.
# Absolute private session directory, outside all public directories; see deployment guide.
SESSION_PATH=

# Public operator details used in privacy/contact pages. Replace for your instance.
NEXT_PUBLIC_OPERATOR_NAME="Your Name"
NEXT_PUBLIC_CONTACT_EMAIL=you@example.org
NEXT_PUBLIC_OPERATOR_COUNTRY="Your Country"
# Docker HTTPS proxy: domain only, no https:// or path.
PUBLIC_HOST=scoreboard.example.org
# Change only if this subnet conflicts with another Docker network.
DOCKER_NETWORK_SUBNET=172.30.47.0/24

# Published privacy policies and last 20 revisions; private, durable directory.
POLICY_PATH=
